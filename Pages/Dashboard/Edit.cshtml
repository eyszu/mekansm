@page "{id:long?}"
@model EditModel
@{
    ViewData["Title"] = Model.PostId is null ? "New post" : "Edit post";
}

<div class="page-head">
    <h1>@ViewData["Title"]</h1>
    @if (Model.IsPublished && Model.Slug is not null)
    {
        <a class="btn btn-ghost btn-sm" asp-page="/Post" asp-route-slug="@Model.Slug">View post</a>
    }
</div>

<form method="post" id="editor-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="field">
        <label asp-for="Input.Title">Title</label>
        <input asp-for="Input.Title" class="title-input" maxlength="200" required autofocus placeholder="A great title" />
        <span asp-validation-for="Input.Title" class="field-error"></span>
    </div>

    <div class="editor-grid">
        <div class="editor-col">
            <div class="toolbar" role="toolbar" aria-label="Markdown formatting">
                <button type="button" data-before="**" data-after="**" title="Bold"><b>B</b></button>
                <button type="button" data-before="*" data-after="*" title="Italic"><i>I</i></button>
                <button type="button" data-before="`" data-after="`" title="Inline code">&lt;/&gt;</button>
                <button type="button" data-before="## " data-after="" title="Heading">H2</button>
                <button type="button" data-before="- " data-after="" title="List">•</button>
                <button type="button" data-before="[" data-after="](https://)" title="Link">Link</button>
            </div>
            <label asp-for="Input.Body" class="sr">Body (Markdown)</label>
            <textarea asp-for="Input.Body" rows="22" spellcheck="true" placeholder="Write in Markdown…"></textarea>
            <span asp-validation-for="Input.Body" class="field-error"></span>
        </div>

        <div class="editor-col">
            <div class="toolbar toolbar-label">Preview</div>
            <article id="preview" class="prose preview" aria-live="polite"></article>
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.Excerpt">Excerpt <span class="hint">(optional, generated from the post if empty)</span></label>
        <textarea asp-for="Input.Excerpt" rows="2" maxlength="500"></textarea>
        <span asp-validation-for="Input.Excerpt" class="field-error"></span>
    </div>

    <div class="form-actions">
        @if (Model.IsPublished)
        {
            <button type="submit" name="Input.Publish" value="true" class="btn btn-primary">Update</button>
            <button type="submit" name="Input.Publish" value="false" class="btn btn-ghost">Unpublish</button>
        }
        else
        {
            <button type="submit" name="Input.Publish" value="true" class="btn btn-primary">Publish</button>
            <button type="submit" name="Input.Publish" value="false" class="btn btn-ghost">Save draft</button>
        }
        <a class="btn btn-ghost" asp-page="Index">Back</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
